---
---

<div
  id="item-sheet-overlay"
  class="fixed inset-0 z-40 hidden bg-black/50"
  aria-hidden="true"
></div>

<aside
  id="item-sheet"
  class="fixed right-0 top-0 z-50 flex h-full w-[380px] flex-col border-l border-border bg-panel max-sm:w-full"
  aria-label="Podrobnosti izdelka"
  aria-modal="true"
  role="dialog"
  hidden
>
  <!-- Header -->
  <div class="flex items-center justify-between border-b border-border px-4 py-3">
    <span class="font-mono text-xs uppercase tracking-widest text-text-muted">
      Podrobnosti
    </span>
    <button
      id="sheet-close"
      type="button"
      class="flex h-7 w-7 items-center justify-center rounded border border-border text-text-muted transition-colors hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      aria-label="Zapri"
    >
      ✕
    </button>
  </div>

  <!-- Body -->
  <div class="flex-1 overflow-y-auto p-4">
    <!-- Main image -->
    <div class="mb-3" style="aspect-ratio: 1">
      <img
        id="sheet-main-image"
        src=""
        alt=""
        class="h-full w-full rounded object-cover"
        style="display: none"
      />
      <div
        id="sheet-image-placeholder"
        class="flex h-full w-full items-center justify-center rounded border border-border bg-border font-mono text-sm text-text-muted"
      >
        [ slika ]
      </div>
    </div>

    <!-- Thumbnails -->
    <div id="sheet-thumbnails" class="mb-4 flex gap-2 overflow-x-auto"></div>

    <!-- Name + price -->
    <div class="mb-4">
      <h2
        id="sheet-name"
        class="mb-1 font-mono text-lg font-bold text-text"
      ></h2>
      <p id="sheet-price" class="font-mono text-base text-accent"></p>
      <p
        id="sheet-description"
        class="mt-2 text-sm leading-relaxed text-text-muted"
      ></p>
    </div>

    <!-- Size selector -->
    <div class="mb-4">
      <p class="mb-2 font-mono text-xs uppercase tracking-widest text-text-muted">
        Velikost
      </p>
      <div id="sheet-sizes" class="flex flex-wrap gap-2"></div>
    </div>

    <!-- Quantity rows -->
    <div id="sheet-qty-section" class="mb-4 hidden">
      <p class="mb-2 font-mono text-xs uppercase tracking-widest text-text-muted">
        Količina
      </p>
      <div id="sheet-qty-rows" class="flex flex-col gap-2"></div>
    </div>

    <!-- Summary -->
    <div
      id="sheet-summary"
      class="hidden rounded border border-border bg-canvas px-3 py-2.5 font-mono text-sm text-text-muted"
    ></div>
  </div>

  <!-- Footer -->
  <div class="border-t border-border p-4">
    <button
      id="sheet-order-btn"
      type="button"
      disabled
      class="w-full cursor-not-allowed rounded border border-border py-2.5 font-mono text-sm font-bold uppercase tracking-widest text-text-muted opacity-40"
    >
      Naroči →
    </button>
  </div>
</aside>
